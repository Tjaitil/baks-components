{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "packages/*/lib/**/*",
    "packages/*/src/**/*",
    "packages/*/components/__tests__",
    "env.d.ts"
  ],
  "exclude": [
    "lib/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "baseUrl": ".",
    "types": [
      "vite/client"
    ],
  }
}