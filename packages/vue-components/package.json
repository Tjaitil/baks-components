{
  "name": "baks-components-vue",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "Kjetil Baksaas",
  "license": "MIT",
  "description": "A collection of vue components for baks components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tjaitil/baks-components.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/index.css",
    "./themes/default.css": "./dist/themes/default.css",
    "./lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && npm run types",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "types": "vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build:css": "postcss -r bundle.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "baks-components-styles": "^0.6.0",
    "glob": "^10.3.12",
    "tailwindcss": "^4.1.11",
    "uuid": "^11.1.0",
    "vue": "^3.4.26"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@rushstack/eslint-patch": "^1.8.0",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-docs": "^9.0.16",
    "@storybook/addon-links": "^9.0.16",
    "@storybook/vue3-vite": "^9.0.16",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.12.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^11.1.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.2.5",
    "storybook": "^9.0.16",
    "typescript": "~5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
