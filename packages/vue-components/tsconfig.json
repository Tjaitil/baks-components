{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "lib/*"
      ]
    },
    "declaration": false,
    "composite": false
  },
  "types": [
    "vitest/globals"
  ],
  "include": [
    "lib/**/*",
    "lib/**/*.vue",
    "src/**/*",
    "vitest.config.ts",
    "vite.config.ts",
    "../../vite.config.ts"
  ],
}